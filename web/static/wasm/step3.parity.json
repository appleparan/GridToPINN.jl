[
  {
    "name": "moving wall (honey), Euler inside its stability limit",
    "ops": [
      {
        "args": [
          50,
          0.1,
          1.0,
          0.002
        ],
        "bind": "sim",
        "fn": "moving_wall"
      },
      {
        "args": [
          "$sim",
          0.0005,
          200,
          1
        ],
        "expected": 0.10000000000000007,
        "fn": "advance"
      },
      {
        "args": [
          "$sim"
        ],
        "expected": 0.10000000000000007,
        "fn": "time"
      },
      {
        "args": [
          "$sim"
        ],
        "bind": "u",
        "fn": "field"
      },
      {
        "args": [
          "$u"
        ],
        "expected": 51,
        "fn": "vec_len"
      },
      {
        "args": [
          "$u",
          1
        ],
        "expected": 1.0,
        "fn": "vec_get"
      },
      {
        "args": [
          "$u",
          2
        ],
        "expected": 0.9204597508085525,
        "fn": "vec_get"
      },
      {
        "args": [
          "$u",
          5
        ],
        "expected": 0.6895757564448952,
        "fn": "vec_get"
      },
      {
        "args": [
          "$u",
          10
        ],
        "expected": 0.368737575046555,
        "fn": "vec_get"
      },
      {
        "args": [
          "$u"
        ],
        "expected": 1.0,
        "fn": "max_abs"
      },
      {
        "args": [
          "$sim",
          1.0
        ],
        "expected": 0.0006173827867734794,
        "fn": "moving_wall_error"
      }
    ],
    "precision": "f64"
  },
