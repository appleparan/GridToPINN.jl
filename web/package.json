{
	"name": "gridtopinn-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:wasm": "cd .. && julia +1.12 --project=wasm wasm/build.jl && node wasm/check_parity.mjs",
		"build:all": "bun run build:wasm && bun run build",
		"preview": "vite preview --strictPort",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "bun run test:e2e:root && bun run test:e2e:sub",
		"test:e2e:root": "vite build && playwright test",
		"test:e2e:sub": "BASE_PATH=/sub vite build && BASE_PATH=/sub playwright test"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.48.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.3",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"pretendard": "^1.3.9",
		"shadcn-svelte": "^1.7.0",
		"shiki": "^4.4.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6",
		"uplot": "^1.6.32",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
}
