{
	"name": "gridtopinn-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:wasm": "cd .. && julia +1.12 --project=wasm wasm/build.jl && node wasm/check_parity.mjs",
		"build:all": "bun run build:wasm && bun run build",
		"preview": "vite preview --strictPort",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "bun run test:e2e:root && bun run test:e2e:sub",
		"test:e2e:root": "vite build && playwright test",
		"test:e2e:sub": "BASE_PATH=/sub vite build && BASE_PATH=/sub playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "~6",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
}
